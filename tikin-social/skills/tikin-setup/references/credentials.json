{
  "schema_version": 1,
  "consumer": {
    "kind": "plugin",
    "name": "tikin-social",
    "skills": [
      "tikin-bulk-data-export",
      "tikin-comments-analysis",
      "tikin-competitor-analysis",
      "tikin-creator-analytics",
      "tikin-douyin",
      "tikin-endpoint-discovery",
      "tikin-hashtag-research",
      "tikin-instagram",
      "tikin-rest-api",
      "tikin-setup",
      "tikin-social-listening",
      "tikin-social-media-downloader",
      "tikin-tiktok",
      "tikin-trend-research",
      "tikin-twitter-threads",
      "tikin-xiaohongshu",
      "tikin-youtube"
    ]
  },
  "keys": {
    "TIKIN_API_KEY": {
      "required": true,
      "sensitive": true,
      "description": "tikin API key belonging to the selected service and account"
    },
    "TIKIN_BASE_URL": {
      "required": false,
      "sensitive": false,
      "description": "API service root belonging to the selected key; no endpoint path or URL credentials",
      "default": "https://console.tikin.net"
    }
  },
  "groups": [
    [
      "TIKIN_API_KEY",
      "TIKIN_BASE_URL"
    ]
  ]
}
