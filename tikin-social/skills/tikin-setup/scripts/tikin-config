#!/usr/bin/env python3
# Shared ADR 0007 bootstrap; this entry remains parseable by Python 3.9.
import os
import shlex
import subprocess
import sys

for stream in (sys.stdin, sys.stdout, sys.stderr):
    if hasattr(stream, "reconfigure"):
        stream.reconfigure(encoding="utf-8")
from _runtime_bootstrap import ensure_runtime
ensure_runtime("TIKIN_SETUP_BOOTSTRAP_REEXEC")
SKILL_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

import argparse
import getpass
import hashlib
import json
from pathlib import Path
import re
import tempfile
import time
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen
from urllib.parse import urlsplit


DEFAULT_SETTINGS = {"routing": {"default": "auto", "platforms": {}}}
# Transient-failure policy (ADR 0006 / the Reliability section of tikin-rest-api):
# 3 attempts in total, waiting 1s then 2s. 429 with Retry-After wins over the backoff.
VALIDATE_MAX_ATTEMPTS = 3
VALIDATE_BACKOFF_SECONDS = (1.0, 2.0)
VALIDATE_RETRY_AFTER_CAP_SECONDS = 60.0
ENV_ASSIGNMENT = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$")
CONFIG_KEYS = ("TIKIN_API_KEY", "TIKIN_BASE_URL")
# Stable identity, checked against manifests in a full Plugin distribution. This
# remains available when an Agent Skills client installs only Skill directories.
PLUGIN_NAME = "tikin-social"
DEFAULT_BASE_URL = "https://console.tikin.net"
SKILL_NAMES = frozenset({
    "tikin-bulk-data-export", "tikin-comments-analysis", "tikin-competitor-analysis",
    "tikin-creator-analytics", "tikin-douyin", "tikin-endpoint-discovery",
    "tikin-hashtag-research", "tikin-instagram", "tikin-rest-api", "tikin-setup",
    "tikin-social-listening", "tikin-social-media-downloader", "tikin-tiktok",
    "tikin-trend-research", "tikin-twitter-threads", "tikin-xiaohongshu", "tikin-youtube",
})
MODES = ("auto", "confirm")
PLATFORMS = (
    "douyin",
    "instagram",
    "threads",
    "tiktok",
    "twitter",
    "xiaohongshu",
    "youtube",
)


def config_dir():
    return Path.home() / ".config" / PLUGIN_NAME


def check_plugin_identity():
    plugin_root = Path(SKILL_DIR).parent.parent
    for directory in (".claude-plugin", ".codex-plugin", ".codebuddy-plugin"):
        path = plugin_root / directory / "plugin.json"
        if path.is_file():
            manifest = json.loads(path.read_text(encoding="utf-8"))
            if manifest.get("name") != PLUGIN_NAME:
                raise SystemExit("Plugin manifest identity disagrees with bundled configuration helper")


def restrict_permissions(path=None, fd=None):
    if fd is not None:
        fchmod = getattr(os, "fchmod", None)
        if fchmod is not None:
            fchmod(fd, 0o600)
    if path is not None:
        try:
            os.chmod(path, 0o600)
        except NotImplementedError:
            if os.name != "nt":
                raise


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        restrict_permissions(fd=fd)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
        os.replace(temporary_name, path)
        restrict_permissions(path=path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def initialize():
    directory = config_dir()
    directory.mkdir(parents=True, exist_ok=True)
    env_path = directory / ".env"
    settings_path = directory / "settings.json"
    for path in (env_path, settings_path):
        if path.is_symlink():
            raise SystemExit(f"refusing symbolic link at {path}")
    if env_path.is_file():
        restrict_permissions(path=env_path)
    if not settings_path.exists():
        from default_skills import update_settings
        update_settings(settings_path, lambda settings: settings.setdefault("routing", {"default": "auto", "platforms": {}}))
    elif settings_path.is_file():
        restrict_permissions(path=settings_path)


def parse_env(text):
    values = {}
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        if key not in CONFIG_KEYS:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
            value = value[1:-1]
        values[key] = value
    return values


def configuration_paths(skill_name, global_enabled):
    if skill_name is not None and skill_name not in SKILL_NAMES:
        raise SystemExit("--skill must name one of the 17 bundled tikin Skills")
    cwd = Path.cwd()
    paths = [cwd / (".env." + skill_name)] if skill_name else []
    paths += [cwd / ".env.local", cwd / ".env"]
    if global_enabled:
        root = config_dir()
        if skill_name:
            paths += [root / skill_name / ".env.local", root / skill_name / ".env",
                      root / (".env." + skill_name)]
        paths += [root / ".env.local", root / ".env"]
        if skill_name:
            paths.append(Path.home() / ".config" / skill_name / ".env")
    return paths


def resolve_config(skill_name="tikin-setup", global_enabled=True, deletion=None):
    """Read only fixed sources. Report each file revision and field source, never values."""
    check_plugin_identity()
    layers = [("environment", os.environ)]
    files, problems = [], []
    paths = configuration_paths(skill_name, global_enabled)
    if deletion:
        target, keys = deletion
        if (not keys or len(set(keys)) != len(keys) or any(key not in CONFIG_KEYS for key in keys)
                or Path(target).resolve() not in [path.resolve() for path in paths]):
            raise SystemExit("Deletion preview requires a known configuration path and declared credential fields")
    for path in paths:
        source = str(path)
        try:
            content = path.read_bytes()
            parsed = parse_env(content.decode("utf-8-sig"))
            if deletion and path.resolve() == Path(deletion[0]).resolve():
                for key in deletion[1]:
                    parsed.pop(key, None)
        except FileNotFoundError:
            files.append({"path": source, "revision": None})
            continue
        except (OSError, UnicodeError):
            files.append({"path": source, "revision": None, "error": "unreadable"})
            problems.append({"source": source, "reason": "unreadable"})
            continue
        files.append({"path": source, "revision": hashlib.sha256(content).hexdigest()})
        layers.append((source, parsed))
    values, sources = {}, {}
    for key in CONFIG_KEYS:
        for source, layer in layers:
            value = layer.get(key)
            if value and value.strip():
                values[key], sources[key] = value, source
                break
    if not values.get("TIKIN_BASE_URL"):
        values["TIKIN_BASE_URL"] = DEFAULT_BASE_URL
        sources["TIKIN_BASE_URL"] = "built-in default"
    fields = {key: {"source": sources.get(key, "missing"), "present": bool(values.get(key))}
              for key in CONFIG_KEYS}
    if not values.get("TIKIN_API_KEY"):
        fields["TIKIN_API_KEY"]["problem"] = "missing"
        problems.append({"key": "TIKIN_API_KEY", "source": "missing", "reason": "missing"})
    try:
        url = urlsplit(values["TIKIN_BASE_URL"])
        valid_url = (url.scheme in ("http", "https") and bool(url.hostname)
                     and not url.username and not url.password and not url.query and not url.fragment)
        _ = url.port
    except ValueError:
        valid_url = False
    if not valid_url:
        fields["TIKIN_BASE_URL"]["problem"] = "invalid_url"
        problems.append({"key": "TIKIN_BASE_URL", "source": sources["TIKIN_BASE_URL"],
                         "reason": "invalid_url"})
    inspection = {
        "schema": "secret-book.config-inspection/v1",
        "status": "configuration_required" if problems else "ok",
        "consumer": {"kind": "plugin", "name": PLUGIN_NAME},
        "skill": skill_name, "cwd": str(Path.cwd()), "global_enabled": global_enabled,
        "layers": files, "fields": fields, "problems": problems,
        "environment": {key: hashlib.sha256(os.environ[key].encode()).hexdigest()
                        if os.environ.get(key, "").strip() else None for key in CONFIG_KEYS},
    }
    return values, sources, inspection


def load_config(skill_name="tikin-setup", global_enabled=True):
    values, sources, inspection = resolve_config(skill_name, global_enabled)
    for problem in inspection["problems"]:
        if problem["reason"] != "missing":
            raise SystemExit(f"configuration {problem['reason']}: {problem['source']}; run config-check")
    return values, sources


def config_check(skill_name="tikin-setup", global_enabled=True, deletion=None):
    _, _, inspection = resolve_config(skill_name, global_enabled)
    if deletion:
        _, _, after = resolve_config(skill_name, global_enabled, deletion)
        print(json.dumps({"schema": "config-deletion-preview/v1", "operation": "delete",
                          "target": str(Path(deletion[0]).absolute()), "fields": deletion[1],
                          "before": inspection, "after": after}, sort_keys=True))
        return
    print(json.dumps(inspection, sort_keys=True))
    if inspection["problems"]:
        raise SystemExit(3)


def run_with_config(skill_name, command, global_enabled=True):
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        raise SystemExit("run requires a command after --")
    values, _ = load_config(skill_name, global_enabled)
    if not values.get("TIKIN_API_KEY"):
        raise SystemExit("missing TIKIN_API_KEY; follow tikin-setup/references/credential-setup.md for setup-aihub:setup-api-key or the minimal local fallback")
    environment = dict(os.environ)
    environment.update(values)
    environment["TIKIN_BASE_URL"] = values.get("TIKIN_BASE_URL") or DEFAULT_BASE_URL
    try:
        if os.name == "nt":
            # Windows has no POSIX process replacement. Forward the child's exit
            # status without using the CRT overlay path (which can crash).
            raise SystemExit(subprocess.run(command, env=environment).returncode)
        os.execvpe(command[0], command, environment)
    except OSError as error:
        raise SystemExit("could not execute configured command: " + error.strerror) from None


def read_settings():
    path = config_dir() / "settings.json"
    if not path.is_file():
        return DEFAULT_SETTINGS
    settings = json.loads(path.read_text(encoding="utf-8"))
    validate_routing(settings)
    return settings


def validate_routing(settings):
    if not isinstance(settings, dict):
        raise SystemExit("settings.json must be an object")
    routing = settings.get("routing")
    if not isinstance(routing, dict) or routing.get("default") not in MODES:
        raise SystemExit("settings.json has an invalid routing.default")
    platforms = routing.get("platforms")
    if not isinstance(platforms, dict):
        raise SystemExit("settings.json has an invalid routing.platforms")
    for platform, mode in platforms.items():
        if platform not in PLATFORMS or mode not in MODES:
            raise SystemExit("settings.json has an invalid platform routing override")


def set_key():
    if sys.stdin.isatty():
        secret = getpass.getpass("TIKIN_API_KEY: ")
    else:
        secret = sys.stdin.read().rstrip("\r\n")
    if not secret or "\n" in secret or "\r" in secret or "\0" in secret:
        raise SystemExit("refusing an empty or multi-line API key")

    path = config_dir() / ".env"
    lines = path.read_text(encoding="utf-8").splitlines() if path.is_file() else []
    # Dotenv values are literal: outer quotes preserve leading/trailing whitespace
    # without shell escaping or changing embedded quote characters.
    encoded = secret
    if secret != secret.strip() or secret[0] in ("'", '"') or secret[-1] in ("'", '"'):
        encoded = '"' + secret + '"'
    replacement = f"TIKIN_API_KEY={encoded}"
    updated = []
    replaced = False
    for line in lines:
        match = ENV_ASSIGNMENT.match(line.strip())
        if match and match.group(1) == "TIKIN_API_KEY":
            if not replaced:
                updated.append(replacement)
                replaced = True
            continue
        updated.append(line)
    if not replaced:
        updated.append(replacement)
    atomic_write(path, "\n".join(updated) + "\n")


def status(skill_name="tikin-setup", global_enabled=True):
    _, sources = load_config(skill_name, global_enabled)
    settings = read_settings() if global_enabled else DEFAULT_SETTINGS
    print(json.dumps({
        "key_configured": "TIKIN_API_KEY" in sources,
        "key_source": sources.get("TIKIN_API_KEY", "missing"),
        "sources": sources,
        "plugin": PLUGIN_NAME, "skill": skill_name, "cwd": str(Path.cwd()),
        "global_enabled": global_enabled,
        "settings": {"routing": settings["routing"]},
    }, sort_keys=True))


def set_routing(default_mode, platform_values, clear_platforms):
    from default_skills import update_settings
    def change(settings):
        validate_routing(settings)
        routing = settings["routing"]
        if default_mode:
            routing["default"] = default_mode
        if clear_platforms:
            routing["platforms"] = {}
        for value in platform_values:
            if "=" not in value:
                raise SystemExit("platform overrides must use PLATFORM=MODE")
            platform, mode = value.split("=", 1)
            if platform not in PLATFORMS:
                raise SystemExit(f"unsupported platform: {platform}")
            if mode not in MODES:
                raise SystemExit(f"unsupported routing mode: {mode}")
            routing["platforms"][platform] = mode
        routing["platforms"] = dict(sorted(routing["platforms"].items()))
    update_settings(config_dir() / "settings.json", change)


def get_policy(platform, global_enabled=True):
    if platform not in PLATFORMS:
        raise SystemExit(f"unsupported platform: {platform}")
    routing = (read_settings() if global_enabled else DEFAULT_SETTINGS)["routing"]
    print(routing["platforms"].get(platform, routing["default"]))


def retry_after_seconds(error):
    """Seconds requested by a 429's Retry-After header, or None to use the backoff."""
    headers = getattr(error, "headers", None)
    raw = headers.get("Retry-After") if headers else None
    if not raw:
        return None
    try:
        seconds = float(str(raw).strip())
    except (TypeError, ValueError):
        return None  # HTTP-date form: fall back to the fixed backoff schedule
    if seconds < 0:
        return None
    return min(seconds, VALIDATE_RETRY_AFTER_CAP_SECONDS)


def log_validation_retry(attempt, reason, delay):
    # Only the failure class is logged. The key is never part of this message.
    sys.stderr.write(
        "key validation attempt %d/%d failed (%s); retrying in %.0fs\n"
        % (attempt, VALIDATE_MAX_ATTEMPTS, reason, delay)
    )


def validate_once(request, timeout):
    """Run one validation call.

    Returns (outcome, detail, retry_after) where outcome is "ok", "fatal" (a
    deterministic failure that must not be retried) or "transient".
    """
    try:
        with urlopen(request, timeout=timeout) as response:
            if 200 <= response.status < 300:
                return ("ok", None, None)
        return ("fatal", "key validation returned an unexpected response", None)
    except HTTPError as error:
        if error.code in (401, 403):
            return ("fatal", f"authentication or permission rejected (HTTP {error.code}); check the configured key and service URL", None)
        if error.code == 429 or error.code >= 500:
            return ("transient", f"HTTP {error.code}", retry_after_seconds(error))
        return ("fatal", f"key validation failed with HTTP {error.code}", None)
    except URLError as error:
        return ("transient", f"connection failed: {error.reason}", None)
    except (TimeoutError, OSError) as error:
        # socket.timeout, connection resets and other transport-level faults.
        return ("transient", f"connection failed: {error}", None)


def validate_key(timeout, skill_name="tikin-setup", global_enabled=True):
    values, _ = load_config(skill_name, global_enabled)
    key = values.get("TIKIN_API_KEY")
    if not key:
        raise SystemExit("missing TIKIN_API_KEY")
    base_url = (
        values.get("TIKIN_BASE_URL")
        or DEFAULT_BASE_URL
    )
    request = Request(
        f"{base_url.rstrip('/')}/api/usage/token/",
        headers={"Authorization": f"Bearer {key}", "Accept": "application/json"},
    )
    reason = "unknown error"
    for attempt in range(1, VALIDATE_MAX_ATTEMPTS + 1):
        outcome, detail, retry_after = validate_once(request, timeout)
        if outcome == "ok":
            print("valid")
            return
        if outcome == "fatal":
            raise SystemExit(detail) from None
        reason = detail
        if attempt == VALIDATE_MAX_ATTEMPTS:
            break
        delay = (
            retry_after
            if retry_after is not None
            else VALIDATE_BACKOFF_SECONDS[attempt - 1]
        )
        log_validation_retry(attempt, reason, delay)
        time.sleep(delay)
    raise SystemExit(
        f"key validation could not reach tikin after {VALIDATE_MAX_ATTEMPTS} attempts ({reason})"
    ) from None


def main():
    parser = argparse.ArgumentParser(description="Manage local tikin configuration safely.")
    identity = parser.add_mutually_exclusive_group()
    identity.add_argument("--skill", default="tikin-setup", help="calling SKILL.md name")
    identity.add_argument("--plugin-only", action="store_true", help="use shared Plugin config without a caller Skill")
    global_options = parser.add_mutually_exclusive_group()
    global_options.add_argument("--no-global-config", action="store_true", help="skip all global config and routing files this call")
    global_options.add_argument("--use-global-config", action="store_true", help="compatibility option; global config is already enabled")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("init")
    subparsers.add_parser("set-key")
    subparsers.add_parser("status")
    inspection_parser = subparsers.add_parser("config-check", help="print configuration sources or a read-only deletion projection")
    inspection_parser.add_argument("--delete-from", help="known source file; never changes the file")
    inspection_parser.add_argument("--delete-fields", help="comma-separated declared fields to project as absent")
    defaults_parser = subparsers.add_parser("default-skills", help="inspect current Agent defaults and manage reminder preferences without API credentials")
    defaults_parser.add_argument("--agent", required=True, choices=("codex", "claude-code", "workbuddy"))
    defaults_parser.add_argument("--action", choices=("check", "dismiss", "enable"), default="check")
    defaults_parser.add_argument("--config-dir", help="actual configuration directory of the current Agent")
    run_parser = subparsers.add_parser("run", help="run a command with resolved tikin configuration")
    run_parser.add_argument("argv", nargs=argparse.REMAINDER)
    set_routing_parser = subparsers.add_parser("set-routing")
    set_routing_parser.add_argument("--default", choices=MODES)
    set_routing_parser.add_argument("--platform", action="append", default=[])
    set_routing_parser.add_argument("--clear-platforms", action="store_true")
    get_policy_parser = subparsers.add_parser("get-policy")
    get_policy_parser.add_argument("platform", choices=PLATFORMS)
    validate_parser = subparsers.add_parser("validate")
    # 30s matches the `--max-time 30` that the Reliability section of
    # tikin-rest-api mandates for every JSON call against $BASE. Validation is
    # exactly such a call, so it must not time out earlier than the documented
    # budget — a 10s cap turned slow-but-healthy responses into "transient
    # failure" retries.
    validate_parser.add_argument("--timeout", type=float, default=30.0)
    args = parser.parse_args()
    check_plugin_identity()
    skill_name = None if args.plugin_only else args.skill
    global_enabled = not args.no_global_config
    if not global_enabled and args.command in ("init", "set-key", "set-routing"):
        parser.error("--no-global-config cannot be combined with a global configuration write")

    if args.command == "default-skills":
        from default_skills import run
        try:
            print(json.dumps(run(args.agent, args.action, args.config_dir, global_enabled), ensure_ascii=False))
        except (OSError, ValueError) as error:
            parser.error(str(error))
    elif args.command == "init":
        initialize()
    elif args.command == "set-key":
        initialize()
        set_key()
    elif args.command == "status":
        status(skill_name, global_enabled)
    elif args.command == "config-check":
        if bool(args.delete_from) != bool(args.delete_fields):
            parser.error("--delete-from and --delete-fields must be provided together")
        deletion = (args.delete_from, args.delete_fields.split(",")) if args.delete_from else None
        config_check(skill_name, global_enabled, deletion)
    elif args.command == "run":
        run_with_config(skill_name, args.argv, global_enabled)
    elif args.command == "set-routing":
        initialize()
        set_routing(args.default, args.platform, args.clear_platforms)
    elif args.command == "get-policy":
        get_policy(args.platform, global_enabled)
    elif args.command == "validate":
        validate_key(args.timeout, skill_name, global_enabled)


if __name__ == "__main__":
    main()
